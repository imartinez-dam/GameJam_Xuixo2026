  m_Script: {fileID: 11500000, guid: 16beeff18b0968b468d3546162170c3f, type: 3}
  m_Name: IntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 0
    text: Benvinguts al Concurs anual de xuixos de Girona!
  - speaker: 0
    text: Supera les proves, prepara el teu xuixo i presenta'l al jurat.
  - speaker: 1
    text: "I si ho faig b\xE9, ser\xE9 el millor pastisser de la ciutat?"
  - speaker: 0
    text: "Ho veurem... per\xF2 compte, que les regles poden canviar."
  - speaker: 1
    text: Perfecte. Som-hi!
