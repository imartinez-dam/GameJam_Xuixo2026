  m_Script: {fileID: 11500000, guid: 16beeff18b0968b468d3546162170c3f, type: 3}
  m_Name: IntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 0
    text: Benvinguts al Concurs anual de xuixos de Girona!
  - speaker: 0
    text: "Nom\xE9s hi pot haver un millor xuixo... i tens dos minuts per fer-lo."
  - speaker: 1
    text: "Dos minuts? F\xE0cil. La massa ja est\xE0 a punt!"
  - speaker: 0
    text: "Compte: cada prova t\xE9 les seves regles. I les regles poden canviar."
  - speaker: 1
    text: "Perfecte. Aquest any, el millor xuixo ser\xE0 el meu!"
